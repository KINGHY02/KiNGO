{
  "name": "kingo",
  "private": true,
  "version": "2.0.6",
  "type": "module",
  "scripts": {
    "postinstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-core-assets.ps1",
    "dev": "vite",
    "prepare:cores": "node scripts/prepare-core-payloads.mjs",
    "build": "npm run prepare:cores && tsc && vite build",
    "check": "npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "bundle": "tauri build --bundles nsis",
    "assets:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-installer-assets.ps1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
